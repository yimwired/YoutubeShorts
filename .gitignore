# Secrets
.env
token_youtube.json
token_tiktok.json
client_secrets.json

# Video output (large files) -- but keep A/B candidate thumbnails:
# swap_thumbnails.py runs on GitHub Actions days after generation and
# needs thumb_*_b.jpg present in the repo (prune_thumbs.py bounds growth).
output/*
!output/thumb_*_b.jpg
*.mp4
*.mp3
# music/cloud/ holds the small mood beds the cloud runner needs, and it
# stays ignored on purpose: this repo is public, so publishing audio is a
# licensing decision that has to be made deliberately rather than swept in
# by a `git add -A`. To ship them once you are sure they are yours to
# publish:  git add -f music/cloud/
# Git tracks them from then on and this line stops applying to them.
*.wav

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.DS_Store

# Models cache
.cache/

# Logs
*.log

# Claude Code settings
.claude/

# Misc
processed_image*

# Overnight reports -- channel analytics, and this repo is public
report_*.html
